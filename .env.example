# Entorno
NODE_ENV=development
PORT=3001

# Postgres (docker compose publica el puerto 5434 en localhost)
DATABASE_URL="postgresql://waylo:CHANGE_ME@127.0.0.1:5434/waylo"

# Secretos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=            # ≥32 chars: HMAC de seudónimos (consents, audit_log)
IPS_TOKEN_KEY=         # 64 hex (32 bytes): AES-256-GCM de los tokens de la IPS

# Sesión web
SESSION_TTL_DAYS=30

# IPS — Confianza (adaptador de la Fase 1)
CONFIANZA_BASE_URL="http://localhost:8000"
CONFIANZA_AGENT_KEY=   # opcional en contrato: header X-Confianza-Agent-Key
CONFIANZA_ENABLED=false
WAYLO_INTERNAL_KEY=    # secreto server-side compartido con waylo.ai

# Grok / LLM (Fase 1)
RETO_KEY=
RETO_BASE_URL="https://api.reto.pltk.mx/v1"
RETO_MODEL="grok-4.20-0309-non-reasoning"
XAI_API_KEY=
LLM_BASE_URL=

# Emergencias — configurables por país
EMERGENCY_PHONE=
MENTAL_HEALTH_PHONE=

# Voz: presupuesto mensual en USD; al agotarse degrada a texto
VOICE_BUDGET_MONTHLY_USD=10

# ── Solo para despliegue (docker-compose.yml) ────────────────────────────────
# POSTGRES_PASSWORD=   # obligatoria para levantar el compose
# WAYLO_DOMAIN=api.tudominio.com   # solo VPS (perfil https); local usa localhost
